    "getonbrd-search": {
      "_comment": "Get on Board (LatAm). Una sola llamada: todo el feed de Perú (empleos en Perú + remotos abiertos a Perú) en categorías técnicas; el puntaje hace el resto.",
      "enabled": true,
      "label": "Get on Board",
      "single_call": true,
      "search_args": {
        "--country": "pe",
        "--category": "programming,machine learning,data,sysadmin,mobile",
        "--jobage": "3",
        "--max-pages": "3",
        "--limit": "100"
      },
      "delay_seconds": 1,
      "detail": false
    },
    "remotive-search": {
      "_comment": "Remotive (remoto). Sus términos piden pocas llamadas al día (máx. 4): una sola llamada por corrida a la categoría completa. Publica con 24 h de retraso, por eso jobage 4. location_allow descarta remotos solo para EE. UU./Europa.",
      "enabled": true,
      "label": "Remotive",
      "single_call": true,
      "search_args": {
        "--category": "software-development",
        "--jobage": "4",
        "--limit": "100"
      },
      "location_allow": ["worldwide", "anywhere", "global", "latam", "latin america", "south america", "\\bamericas\\b", "per[uú]", "\\blima\\b"],
      "delay_seconds": 0,
      "detail": false
    },
    "himalayas-search": {
      "_comment": "Himalayas (remoto). --country Peru devuelve solo empleos que aceptan residentes en Perú (más los worldwide). Lista corta de consultas propia para cuidar el límite público.",
